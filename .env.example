# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Random secret of at least 32 characters for signed admin session cookies
JWT_SECRET=replace-with-a-long-random-secret

# Shared password for /admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional email delivery through Resend
RESEND_API_KEY=
EMAIL_FROM=sales@kadcontrols.co.ke
ENQUIRY_NOTIFICATION_EMAIL=georgemutinda@kadcontrols.co.ke

# Optional public API base URL; leave unset for same-origin requests
NEXT_PUBLIC_API_URL=
